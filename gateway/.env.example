# Gateway settings
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=INFO

# Agent Core (primary AI backend)
AGENT_CORE_URL=http://agent-core:8000

# LLM Router (fallback if agent-core unavailable)
LOCAL_AI_URL=http://llm-router:8000
LOCAL_AI_API_KEY=lai_your_api_key_here

# Discord
DISCORD_TOKEN=your_discord_bot_token_here

# Mattermost
MATTERMOST_URL=mattermost.server.unarmedpuppy.com
MATTERMOST_SCHEME=https
MATTERMOST_PORT=443
MATTERMOST_BOT_TAYNE_TOKEN=your_tayne_bot_token_here
MATTERMOST_BOT_MONITOR_TOKEN=your_monitor_bot_token_here
MATTERMOST_BOT_TRADING_TOKEN=your_trading_bot_token_here
TAYNE_WEBHOOK_TOKEN=your_mattermost_outgoing_webhook_token
